<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="section-2-6">
    <title>Section 2.6 Transformation of Graphs</title>

    <!-- ========================================================
         INTRODUCTION
         ======================================================== -->

    <subsection xml:id="intro-transformations">
        <title>Introduction to Parent Functions</title>

        <p>
            Students should be able to recognize the basic shapes of the graphs of different types of functions.
        </p>

        <p>
            For instance, you know that the graph of the linear function <m>f(x) = mx + b</m> is a line with slope <m>m</m> and <m>y</m>-intercept at <m>(0, b)</m>.
        </p>

        <figure>
            <caption>Linear Function: <m>f(x) = mx + b</m></caption>
            <image width="60%">
                <latex-image>
                    <![CDATA[
                    \begin{adjustbox}{max width=\linewidth}
                    \begin{tikzpicture}[x=0.55cm,y=0.55cm,>=stealth,line cap=round,line join=round]
                        \draw[gray!50,line width=0.4pt] (-8,-8) grid[step=1] (8,8);
                        \draw[black!80,thick,->] (-8.5,0) -- (8.5,0) node[anchor=west,font=\tiny] {$x$};
                        \draw[black!80,thick,->] (0,-8.5) -- (0,8.5) node[anchor=south,font=\tiny] {$y$};
                        \foreach \x in {-8,-7,...,8} {\draw[black!80,thick] (\x,0.1) -- (\x,-0.1);}
                        \foreach \y in {-8,-7,...,8} {\draw[black!80,thick] (0.1,\y) -- (-0.1,\y);}
                        \foreach \x in {-6,-4,-2,2,4,6} {\node[font=\tiny,anchor=north] at (\x,-0.2) {$\x$};}
                        \foreach \y in {-6,-4,-2,2,4,6} {\node[font=\tiny,anchor=east] at (-0.2,\y) {$\y$};}
                        \draw[graphblue,thick] (-8,-2) -- (8,6);
                        \fill[red] (0,2) circle (0.12);
                        \node[graphblue,font=\large] at (3.5,5.5) {$f(x)=mx+b$};
                        \node[red,font=\small] at (0.6,1.5) {$(0,b)$};
                        \node[graphblue,font=\small] at (5,3.8) {$m=\frac12$};
                    \end{tikzpicture}
                    \end{adjustbox}
                    ]]>
                </latex-image>
            </image>
        </figure>
    </subsection>

    <!-- ========================================================
         LINEAR FUNCTIONS
         ======================================================== -->

    <subsection xml:id="linear-functions">
        <title>Linear Functions</title>

        <definition>
            <title>Linear Function</title>
            <p>
                A function of the form <m>f(x) = mx + b</m> has:
            </p>
            <ul>
                <li>Domain: all real numbers</li>
                <li>Range: all real numbers</li>
                <li><m>x</m>-intercept: <m>(-b/m, 0)</m>, <m>y</m>-intercept: <m>(0, b)</m></li>
                <li>Increasing if <m>m &gt; 0</m>, decreasing if <m>m &lt; 0</m>, constant if <m>m = 0</m></li>
            </ul>
        </definition>

        <sidebyside widths="50% 50%">
            <figure>
                <caption>Increasing <m>(m &gt; 0)</m></caption>
                <image width="100%">
                    <latex-image>
                        <![CDATA[
                        \begin{adjustbox}{max width=\linewidth}
                        \begin{tikzpicture}[x=0.5cm,y=0.5cm,>=stealth,line cap=round,line join=round]
                            \draw[gray!50,line width=0.4pt] (-6,-6) grid[step=1] (6,6);
                            \draw[black!80,thick,->] (-6.5,0) -- (6.5,0) node[anchor=west,font=\tiny] {$x$};
                            \draw[black!80,thick,->] (0,-6.5) -- (0,6.5) node[anchor=south,font=\tiny] {$y$};
                            \foreach \x in {-6,-5,...,6} {\draw[black!80,thick] (\x,0.1) -- (\x,-0.1);}
                            \foreach \y in {-6,-5,...,6} {\draw[black!80,thick] (0.1,\y) -- (-0.1,\y);}
                            \foreach \x in {-4,-2,2,4} {\node[font=\tiny,anchor=north] at (\x,-0.2) {$\x$};}
                            \foreach \y in {-4,-2,2,4} {\node[font=\tiny,anchor=east] at (-0.2,\y) {$\y$};}
                            \draw[graphblue,thick] (-6,-0.8) -- (6,1.6);
                            \fill[red] (-2,0) circle (0.1);
                            \fill[red] (3,1) circle (0.1);
                            \node[graphblue,font=\large] at (1.5,-1.2) {$m=\frac15$};
                        \end{tikzpicture}
                        \end{adjustbox}
                        ]]>
                    </latex-image>
                </image>
            </figure>

            <figure>
                <caption>Constant <m>(m = 0)</m></caption>
                <image width="100%">
                    <latex-image>
                        <![CDATA[
                        \begin{adjustbox}{max width=\linewidth}
                        \begin{tikzpicture}[x=0.5cm,y=0.5cm,>=stealth,line cap=round,line join=round]
                            \draw[gray!50,line width=0.4pt] (-6,-6) grid[step=1] (6,6);
                            \draw[black!80,thick,->] (-6.5,0) -- (6.5,0) node[anchor=west,font=\tiny] {$x$};
                            \draw[black!80,thick,->] (0,-6.5) -- (0,6.5) node[anchor=south,font=\tiny] {$y$};
                            \foreach \x in {-6,-5,...,6} {\draw[black!80,thick] (\x,0.1) -- (\x,-0.1);}
                            \foreach \y in {-6,-5,...,6} {\draw[black!80,thick] (0.1,\y) -- (-0.1,\y);}
                            \foreach \x in {-4,-2,2,4} {\node[font=\tiny,anchor=north] at (\x,-0.2) {$\x$};}
                            \foreach \y in {-4,-2,2,4} {\node[font=\tiny,anchor=east] at (-0.2,\y) {$\y$};}
                            \draw[graphblue,thick] (-6,2) -- (6,2);
                            \fill[red] (-3,2) circle (0.1);
                            \fill[red] (3,2) circle (0.1);
                            \node[graphblue,font=\large] at (1.5,4) {$m=0$};
                        \end{tikzpicture}
                        \end{adjustbox}
                        ]]>
                    </latex-image>
                </image>
            </figure>
        </sidebyside>

        <!-- FIX 12: Decreasing graph extended to full grid -6 to 6 -->
        <figure>
            <caption>Decreasing <m>(m &lt; 0)</m></caption>
            <image width="33%">
                <latex-image>
                    <![CDATA[
                    \begin{adjustbox}{max width=\linewidth}
                    \begin{tikzpicture}[x=0.5cm,y=0.5cm,>=stealth,line cap=round,line join=round]
    \draw[gray!50,line width=0.4pt] (-6,-6) grid[step=1] (6,6);
    \draw[black!80,thick,->] (-6.5,0) -- (6.5,0) node[anchor=west,font=\tiny] {$x$};
    \draw[black!80,thick,->] (0,-6.5) -- (0,6.5) node[anchor=south,font=\tiny] {$y$};
    \foreach \x in {-6,-5,...,6} {\draw[black!80,thick] (\x,0.1) -- (\x,-0.1);}
    \foreach \y in {-6,-5,...,6} {\draw[black!80,thick] (0.1,\y) -- (-0.1,\y);}
    \foreach \x in {-4,-2,2,4} {\node[font=\tiny,anchor=north] at (\x,-0.2) {$\x$};}
    \foreach \y in {-4,-2,2,4} {\node[font=\tiny,anchor=east] at (-0.2,\y) {$\y$};}
    % Line spanning full grid: y = -5x + 4
    % At y=6: x = (4-6)/5 = -0.4
    % At y=-6: x = (4-(-6))/5 = 2
    \draw[graphblue,thick] (-0.4,6) -- (2,-6);
    \fill[red] (0,4) circle (0.1);
    \fill[red] (1,-1) circle (0.1);
    \node[graphblue,font=\large] at (3.5,4.5) {$m=-5$};
\end{tikzpicture}
                    \end{adjustbox}
                    ]]>
                </latex-image>
            </image>
        </figure>

        <subsection xml:id="constant-identity-functions">
            <title>Constant and Identity Functions</title>

            <p>
                There are two special types of linear functions, the <term>constant function</term> and the <term>identity function</term>.
            </p>

            <definition>
                <title>Constant Function</title>
                <p>
                    A function of the form <m>f(x) = c</m> where <m>c</m> is a constant.
                </p>
                <ul>
                    <li>Domain: all real numbers</li>
                    <li>Range: <m>\{c\}</m></li>
                    <li>Graph is a horizontal line</li>
                </ul>
            </definition>

            <figure>
                <caption>Constant Function: <m>f(x) = c</m></caption>
                <image width="40%">
                    <latex-image>
                        <![CDATA[
                        \begin{adjustbox}{max width=\linewidth}
                        \begin{tikzpicture}[x=0.55cm,y=0.55cm,>=stealth,line cap=round,line join=round]
                            \draw[gray!50,line width=0.4pt] (-6,-6) grid[step=1] (6,6);
                            \draw[black!80,thick,->] (-6.5,0) -- (6.5,0) node[anchor=west,font=\tiny] {$x$};
                            \draw[black!80,thick,->] (0,-6.5) -- (0,6.5) node[anchor=south,font=\tiny] {$y$};
                            \foreach \x in {-6,-5,...,6} {\draw[black!80,thick] (\x,0.1) -- (\x,-0.1);}
                            \foreach \y in {-6,-5,...,6} {\draw[black!80,thick] (0.1,\y) -- (-0.1,\y);}
                            \foreach \x in {-4,-2,2,4} {\node[font=\tiny,anchor=north] at (\x,-0.2) {$\x$};}
                            \foreach \y in {-4,-2,2,4} {\node[font=\tiny,anchor=east] at (-0.2,\y) {$\y$};}
                            \draw[graphblue,thick] (-6,3) -- (6,3);
                            \fill[red] (0,3) circle (0.12);
                            \node[graphblue,font=\large] at (4,3.8) {$f(x)=c$};
                        \end{tikzpicture}
                        \end{adjustbox}
                        ]]>
                    </latex-image>
                </image>
            </figure>

            <definition>
                <title>Identity Function</title>
                <p>
                    A function of the form <m>f(x) = x</m>.
                </p>
                <ul>
                    <li>Domain: all real numbers</li>
                    <li>Range: all real numbers</li>
                    <li>Slope: <m>m = 1</m></li>
                    <li><m>y</m>-intercept: <m>(0, 0)</m></li>
                </ul>
            </definition>

            <figure>
                <caption>Identity Function: <m>f(x) = x</m></caption>
                <image width="40%">
                    <latex-image>
                        <![CDATA[
                        \begin{adjustbox}{max width=\linewidth}
                        \begin{tikzpicture}[x=0.55cm,y=0.55cm,>=stealth,line cap=round,line join=round]
                            \draw[gray!50,line width=0.4pt] (-6,-6) grid[step=1] (6,6);
                            \draw[black!80,thick,->] (-6.5,0) -- (6.5,0) node[anchor=west,font=\tiny] {$x$};
                            \draw[black!80,thick,->] (0,-6.5) -- (0,6.5) node[anchor=south,font=\tiny] {$y$};
                            \foreach \x in {-6,-5,...,6} {\draw[black!80,thick] (\x,0.1) -- (\x,-0.1);}
                            \foreach \y in {-6,-5,...,6} {\draw[black!80,thick] (0.1,\y) -- (-0.1,\y);}
                            \foreach \x in {-4,-2,2,4} {\node[font=\tiny,anchor=north] at (\x,-0.2) {$\x$};}
                            \foreach \y in {-4,-2,2,4} {\node[font=\tiny,anchor=east] at (-0.2,\y) {$\y$};}
                            \draw[graphblue,thick] (-6,-6) -- (6,6);
                            \fill[red] (0,0) circle (0.12);
                            \fill[red] (2,2) circle (0.12);
                            \node[graphblue,font=\tiny] at (1.15,0.35) {$m=1$};
                            \node[graphblue,font=\large] at (2,4.5) {$f(x)=x$};
                        \end{tikzpicture}
                        \end{adjustbox}
                        ]]>
                    </latex-image>
                </image>
            </figure>
        </subsection>
    </subsection>

    <!-- ========================================================
         SQUARING (QUADRATIC) FUNCTIONS
         ======================================================== -->

    <subsection xml:id="quadratic-functions">
        <title>Squaring (Quadratic) Functions</title>

        <definition>
            <title>Squaring Function</title>
            <p>
                <me>f(x) = x^2</me>
            </p>
            <ul>
                <li>Domain: all real numbers</li>
                <li>Range: <m>[0, \infty)</m></li>
                <li>Even function</li>
                <li>Intercept at <m>(0, 0)</m></li>
                <li>Decreasing on <m>(-\infty, 0)</m>, increasing on <m>(0, \infty)</m></li>
                <li>Symmetric about the <m>y</m>-axis</li>
            </ul>
        </definition>

        <figure>
            <caption>Graph of <m>f(x) = x^2</m></caption>
            <image width="40%">
                <latex-image>
                    <![CDATA[
                    \begin{adjustbox}{max width=\linewidth}
                    \begin{tikzpicture}[x=0.55cm,y=0.55cm,>=stealth,line cap=round,line join=round]
                        \draw[gray!50,line width=0.4pt] (-8,-8) grid[step=1] (8,8);
                        \draw[black!80,thick,->] (-8.5,0) -- (8.5,0) node[anchor=west,font=\tiny] {$x$};
                        \draw[black!80,thick,->] (0,-8.5) -- (0,8.5) node[anchor=south,font=\tiny] {$y$};
                        \foreach \x in {-8,-7,...,8} {\draw[black!80,thick] (\x,0.1) -- (\x,-0.1);}
                        \foreach \y in {-8,-7,...,8} {\draw[black!80,thick] (0.1,\y) -- (-0.1,\y);}
                        \foreach \x in {-6,-4,-2,2,4,6} {\node[font=\tiny,anchor=north] at (\x,-0.2) {$\x$};}
                        \foreach \y in {-6,-4,-2,2,4,6} {\node[font=\tiny,anchor=east] at (-0.2,\y) {$\y$};}
                        \draw[graphblue,thick,domain=-2.8:2.8,samples=100] plot (\x,{\x*\x});
                        \fill[red] (0,0) circle (0.12);
                        \fill[red] (2,4) circle (0.12);
                        \fill[red] (-2,4) circle (0.12);
                        \node[graphblue,font=\large] at (4.1,5.5) {$f(x)=x^2$};
                    \end{tikzpicture}
                    \end{adjustbox}
                    ]]>
                </latex-image>
            </image>
        </figure>
    </subsection>

    <!-- ========================================================
         CUBIC FUNCTIONS
         ======================================================== -->

    <subsection xml:id="cubic-functions">
        <title>Cubic Functions</title>

        <definition>
            <title>Cubic Function</title>
            <p>
                <me>f(x) = x^3</me>
            </p>
            <ul>
                <li>Domain: all real numbers</li>
                <li>Range: all real numbers</li>
                <li>Odd function</li>
                <li>Intercept at <m>(0, 0)</m></li>
                <li>Increasing on <m>(-\infty, \infty)</m></li>
                <li>Symmetric about the origin</li>
            </ul>
        </definition>

        <figure>
            <caption>Graph of <m>f(x) = x^3</m></caption>
            <image width="40%">
                <latex-image>
                    <![CDATA[
                    \begin{adjustbox}{max width=\linewidth}
                    \begin{tikzpicture}[x=0.55cm,y=0.55cm,>=stealth,line cap=round,line join=round]
                        \draw[gray!50,line width=0.4pt] (-8,-8) grid[step=1] (8,8);
                        \draw[black!80,thick,->] (-8.5,0) -- (8.5,0) node[anchor=west,font=\tiny] {$x$};
                        \draw[black!80,thick,->] (0,-8.5) -- (0,8.5) node[anchor=south,font=\tiny] {$y$};
                        \foreach \x in {-8,-7,...,8} {\draw[black!80,thick] (\x,0.1) -- (\x,-0.1);}
                        \foreach \y in {-8,-7,...,8} {\draw[black!80,thick] (0.1,\y) -- (-0.1,\y);}
                        \foreach \x in {-6,-4,-2,2,4,6} {\node[font=\tiny,anchor=north] at (\x,-0.2) {$\x$};}
                        \foreach \y in {-6,-4,-2,2,4,6} {\node[font=\tiny,anchor=east] at (-0.2,\y) {$\y$};}
                        \clip (-8,-8) rectangle (8,8);
                        \draw[graphblue,thick,domain=-2.2:2.2,samples=100] plot (\x,{\x*\x*\x});
                        \fill[red] (0,0) circle (0.12);
                        \fill[red] (1,1) circle (0.12);
                        \fill[red] (-1,-1) circle (0.12);
                        \node[graphblue,font=\large] at (3.5,3.5) {$f(x)=x^3$};
                    \end{tikzpicture}
                    \end{adjustbox}
                    ]]>
                </latex-image>
            </image>
        </figure>
    </subsection>

    <!-- ========================================================
         SQUARE ROOT FUNCTIONS
         ======================================================== -->

    <subsection xml:id="square-root-functions">
        <title>Square Root Functions</title>

        <definition>
            <title>Square Root Function</title>
            <p>
                <me>f(x) = \sqrt{x}</me>
            </p>
            <ul>
                <li>Domain: <m>[0, \infty)</m></li>
                <li>Range: <m>[0, \infty)</m></li>
                <li>Intercept at <m>(0, 0)</m></li>
                <li>Increasing on <m>(0, \infty)</m></li>
            </ul>
        </definition>

        <figure>
            <caption>Graph of <m>f(x) = \sqrt{x}</m></caption>
            <image width="40%">
                <latex-image>
                    <![CDATA[
                    \begin{adjustbox}{max width=\linewidth}
                    \begin{tikzpicture}[x=0.55cm,y=0.55cm,>=stealth,line cap=round,line join=round]
                        \draw[gray!50,line width=0.4pt] (-2,-2) grid[step=1] (10,8);
                        \draw[black!80,thick,->] (-2.5,0) -- (10.5,0) node[anchor=west,font=\tiny] {$x$};
                        \draw[black!80,thick,->] (0,-2.5) -- (0,8.5) node[anchor=south,font=\tiny] {$y$};
                        \foreach \x in {-2,-1,...,10} {\draw[black!80,thick] (\x,0.1) -- (\x,-0.1);}
                        \foreach \y in {-2,-1,...,8} {\draw[black!80,thick] (0.1,\y) -- (-0.1,\y);}
                        \foreach \x in {2,4,6,8} {\node[font=\tiny,anchor=north] at (\x,-0.2) {$\x$};}
                        \foreach \y in {2,4,6} {\node[font=\tiny,anchor=east] at (-0.2,\y) {$\y$};}
                        \node[font=\tiny,anchor=north] at (0,-0.2) {0};
                        \draw[graphblue,thick,domain=0:10,samples=100] plot (\x,{sqrt(\x)});
                        \fill[red] (0,0) circle (0.12);
                        \fill[red] (1,1) circle (0.12);
                        \fill[red] (4,2) circle (0.12);
                        \node[graphblue,font=\large] at (6,4.5) {$f(x)=\sqrt{x}$};
                    \end{tikzpicture}
                    \end{adjustbox}
                    ]]>
                </latex-image>
            </image>
        </figure>
    </subsection>

    <!-- ========================================================
         RECIPROCAL FUNCTIONS
         ======================================================== -->

    <subsection xml:id="reciprocal-functions">
        <title>Reciprocal Functions</title>

        <definition>
            <title>Reciprocal Function</title>
            <p>
                <me>f(x) = \frac{1}{x}</me>
            </p>
            <ul>
                <li>Domain: <m>(-\infty, 0) \cup (0, \infty)</m></li>
                <li>Range: <m>(-\infty, 0) \cup (0, \infty)</m></li>
                <li>Odd function</li>
                <li>No intercepts</li>
                <li>Decreasing on <m>(-\infty, 0)</m> and <m>(0, \infty)</m></li>
                <li>Symmetric about the origin</li>
            </ul>
        </definition>

        <figure>
            <caption>Graph of <m>f(x) = \frac{1}{x}</m></caption>
            <image width="40%">
                <latex-image>
                    <![CDATA[
                    \begin{adjustbox}{max width=\linewidth}
                    \begin{tikzpicture}[x=0.55cm,y=0.55cm,>=stealth,line cap=round,line join=round]
                        \draw[gray!50,line width=0.4pt] (-8,-8) grid[step=1] (8,8);
                        \draw[black!80,thick,->] (-8.5,0) -- (8.5,0) node[anchor=west,font=\tiny] {$x$};
                        \draw[black!80,thick,->] (0,-8.5) -- (0,8.5) node[anchor=south,font=\tiny] {$y$};
                        \foreach \x in {-8,-7,...,8} {\draw[black!80,thick] (\x,0.1) -- (\x,-0.1);}
                        \foreach \y in {-8,-7,...,8} {\draw[black!80,thick] (0.1,\y) -- (-0.1,\y);}
                        \foreach \x in {-6,-4,-2,2,4,6} {\node[font=\tiny,anchor=north] at (\x,-0.2) {$\x$};}
                        \foreach \y in {-6,-4,-2,2,4,6} {\node[font=\tiny,anchor=east] at (-0.2,\y) {$\y$};}
                        \draw[graphblue,thick,domain=-8:-0.15,samples=100] plot (\x,{1/\x});
                        \draw[graphblue,thick,domain=0.15:8,samples=100] plot (\x,{1/\x});
                        \fill[red] (1,1) circle (0.12);
                        \fill[red] (-1,-1) circle (0.12);
                        \node[graphblue,font=\large] at (4,2.5) {$f(x)=\frac1x$};
                    \end{tikzpicture}
                    \end{adjustbox}
                    ]]>
                </latex-image>
            </image>
        </figure>
    </subsection>

    <!-- ========================================================
         GREATEST INTEGER (STEP) FUNCTION
         ======================================================== -->

    <subsection xml:id="greatest-integer-function">
        <title>Step Functions: Greatest Integer Function</title>

        <p>
            Functions whose graphs resemble sets of stairsteps are known as <term>step functions</term>. The most famous of the step functions is the <term>greatest integer function</term>, denoted by <m>\lfloor x \rfloor</m> and defined as:
        </p>
        <me>f(x) = \lfloor x \rfloor</me>
        <p>
            where <m>\lfloor x \rfloor</m> is the greatest integer less than or equal to <m>x</m>.
        </p>

        <p>
            Some values are:
        </p>
        <me>\lfloor -1 \rfloor = -1</me>
        <me>\lfloor -0.5 \rfloor = -1</me>
        <me>\lfloor 0.1 \rfloor = 0</me>
        <me>\lfloor 1.5 \rfloor = 1</me>

        <definition>
            <title>Greatest Integer Function</title>
            <p>
                <me>f(x) = \lfloor x \rfloor</me>
            </p>
            <ul>
                <li>Domain: all real numbers</li>
                <li>Range: all integers</li>
                <li><m>y</m>-intercept at <m>(0, 0)</m></li>
                <li><m>x</m>-intercepts in <m>[0, 1)</m></li>
                <li>Constant between consecutive integers</li>
                <li>Jumps vertically one unit at each integer</li>
            </ul>
        </definition>

        <figure>
            <caption>Graph of <m>f(x) = \lfloor x \rfloor</m></caption>
            <image width="40%">
                <latex-image>
                    <![CDATA[
                    \begin{adjustbox}{max width=\linewidth}
                    \begin{tikzpicture}[x=0.55cm,y=0.55cm,>=stealth,line cap=round,line join=round]
                        \draw[gray!50,line width=0.4pt] (-8,-8) grid[step=1] (8,8);
                        \draw[black!80,thick,->] (-8.5,0) -- (8.5,0) node[anchor=west,font=\tiny] {$x$};
                        \draw[black!80,thick,->] (0,-8.5) -- (0,8.5) node[anchor=south,font=\tiny] {$y$};
                        \foreach \x in {-8,-7,...,8} {\draw[black!80,thick] (\x,0.1) -- (\x,-0.1);}
                        \foreach \y in {-8,-7,...,8} {\draw[black!80,thick] (0.1,\y) -- (-0.1,\y);}
                        \foreach \x in {-6,-4,-2,2,4,6} {\node[font=\tiny,anchor=north] at (\x,-0.2) {$\x$};}
                        \foreach \y in {-6,-4,-2,2,4,6} {\node[font=\tiny,anchor=east] at (-0.2,\y) {$\y$};}
                        \foreach \k in {-8,-7,...,7}{
                            \draw[graphblue,thick] (\k,\k) -- (\k+1,\k);
                            \draw[graphblue,fill=white] (\k+1,\k) circle (0.08);
                            \fill[graphblue] (\k,\k) circle (0.08);
                        }
                        \node[graphblue,font=\large] at (4,3.5) {$f(x)=\lfloor x\rfloor$};
                    \end{tikzpicture}
                    \end{adjustbox}
                    ]]>
                </latex-image>
            </image>
        </figure>
    </subsection>

