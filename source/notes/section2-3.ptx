<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="section-2-3">
    <title>Section 2.3 Functions</title>

   <!-- ========================================================
     INTRODUCTION TO FUNCTIONS
     ======================================================== -->

<subsection xml:id="intro-functions">
    <title>Introduction to Functions</title>

    <!-- Video 1: Functions -->
    <p><url href="https://echo360.org/media/757cd5c4-957c-4cfb-8575-54d160440dab/public">Functions Video</url></p>

    <p>
        A <term>function</term> is a relation between two sets that takes each input to <term>exactly one</term> output.
    </p>

    <!-- IMAGE 1: Function vs Non-Function -->
    <p>
        <image width="90%">
            <latex-image>
                <![CDATA[
                \begin{adjustbox}{max width=\linewidth}
                \begin{tikzpicture}[
                    x=1cm,
                    y=1cm,
                    >=Stealth,
                    every node/.style={font=\normalsize}
                ]

                % ============================================================
                % LEFT DIAGRAM: FUNCTION
                % ============================================================

                % Titles
                \node[font=\Large\bfseries] at (0,3.4) {Function};
                \node[font=\large\bfseries] at (0,2.7) {People};
                \node[font=\large\bfseries] at (5,2.7) {Ages};

                % Left set
                \draw[
                    fill=lightorange,
                    draw=black,
                    thick
                ] (0,0) ellipse (1.5 and 2.1);

                % Right set
                \draw[
                    fill=lightcyan,
                    draw=black,
                    thick
                ] (5,0) ellipse (1.2 and 2.1);

                % People
                \node at (0,1) {Alice};
                \node at (0,0) {Bob};
                \node at (0,-1) {Carlos};

                % Ages
                \node at (5,1) {18};
                \node at (5,0) {21};
                \node at (5,-1) {25};

                % Arrows
                \draw[->,thick] (0.65,1) -- (4.35,1);
                \draw[->,thick] (0.65,0) -- (4.35,0);
                \draw[->,thick] (0.65,-1) -- (4.35,0);

                % Explanation
                \node[
                    draw=blue,
                    thick,
                    align=center,
                    text width=5.2cm,
                    minimum height=1.0cm
                ] at (2.5,-3.0)
                {\textbf{Each person has exactly one age.}\\
                This is a \textbf{function}.};

                % ============================================================
                % RIGHT DIAGRAM: NOT A FUNCTION
                % ============================================================

                % Titles
                \node[font=\Large\bfseries] at (10.5,3.4) {Not a Function};
                \node[font=\large\bfseries] at (10.5,2.7) {People};
                \node[font=\large\bfseries] at (15.5,2.7) {Ages};

                % Left set
                \draw[
                    fill=lightorange,
                    draw=black,
                    thick
                ] (10.5,0) ellipse (1.5 and 2.1);

                % Right set
                \draw[
                    fill=lightcyan,
                    draw=black,
                    thick
                ] (15.5,0) ellipse (1.2 and 2.1);

                % People
                \node at (10.5,1) {Alice};
                \node at (10.5,0) {Bob};
                \node at (10.5,-1) {Carlos};

                % Ages
                \node at (15.5,1) {18};
                \node at (15.5,0) {21};
                \node at (15.5,-1) {25};

                % Arrows
                \draw[->,thick] (11.15,1) -- (14.85,1);

                % Bob has TWO outputs
                \draw[->,thick] (11.15,0) -- (14.85,1);
                \draw[->,thick] (11.15,0) -- (14.85,0);

                % Carlos
                \draw[->,thick] (11.15,-1) -- (14.85,-1);

                % Explanation
                \node[
                    draw=red,
                    thick,
                    align=center,
                    text width=5.2cm,
                    minimum height=1.0cm
                ] at (13,-3.0)
                {\textbf{Bob is associated with two ages.}\\
                This is \textbf{not a function}.};

                \end{tikzpicture}
                \end{adjustbox}
                ]]>
            </latex-image>
        </image>
    </p>

    <!-- Formal Definitions -->
    <definition>
        <title>Domain</title>
        <p>The set of inputs (<m>x</m>-values) of the relation.</p>
    </definition>

    <definition>
        <title>Range</title>
        <p>The set of outputs (<m>y</m>-values) of the relation.</p>
    </definition>

    <p>
        Most functions we work with have names like <m>f</m>, <m>g</m>, and <m>h</m>.
    </p>

    <!-- IMAGE 2: Domain/Range Mapping Diagram -->
  <figure xml:id="function-age" visibility="hidden">
    <caption>Domain and Range Mapping</caption>
    <image width="60%">
        <latex-image>
            <![CDATA[
            \begin{adjustbox}{max width=\linewidth}
            \begin{tikzpicture}[
                x=1cm,
                y=1cm,
                >=Stealth,
                every node/.style={font=\normalsize}
            ]

            % ============================================================
            % DOMAIN (Left Set)
            % ============================================================
            \node[font=\large\bfseries, above] at (-2.5, 2.3) {\textbf{Domain}};
            \draw[fill=orange!30, draw=black, thick] (-2.5, 0) ellipse (1.5 and 2.1);

            % ============================================================
            % CODOMAIN (Right Set - Outer)
            % ============================================================
            \node[font=\large\bfseries, above] at (2.5, 2.3) {\textbf{Codomain}};
            \draw[fill=cyan!30, draw=black, thick] (2.5, 0) ellipse (1.2 and 2.1);

            % ============================================================
            % RANGE (Inner Red Ellipse - only the actual outputs)
            % ============================================================
            \draw[fill=red!20, draw=red, thick, dashed] (2.5, 0.2) ellipse (0.9 and 1.2);
            \node[font=\small\bfseries, red] at (2.5, -0.8) {\textbf{Range}};

            % ============================================================
            % ELEMENTS
            % ============================================================
            % People (Domain)
            \node at (-2.5, 1.2) {Alice};
            \node at (-2.5, 0.0) {Bob};
            \node at (-2.5, -1.2) {Carlos};

            % Ages (Codomain)
            \node at (2.5, 1.2) {18};
            \node at (2.5, 0.0) {21};
            \node at (2.5, -1.2) {25};

            % ============================================================
            % MAPPING ARROWS
            % ============================================================
            \draw[->, thick] (-1.0, 1.2) -- (1.3, 1.2);
            \draw[->, thick] (-1.0, 0.0) -- (1.3, 0.0);
            \draw[->, thick] (-1.0, -1.2) -- (1.3, 0.0);

            % ============================================================
            % FUNCTION ARROW
            % ============================================================
            \draw[->, thick, bend left=45, color=blue!70!black] 
                (-2.5, 2.8) to node[above, font=\Large, color=blue!70!black] {$f$} (2.5, 2.8);

            \end{tikzpicture}
            \end{adjustbox}
            ]]>
        </latex-image>
    </image>
</figure>

    <p>
        Think of a function as a machine: you put in an <m>x</m>-value (input), and the machine gives you a corresponding <em effect="bold">unique</em> <m>y</m>-value (output).
    </p>

    <!-- IMAGES 3 & 4: Function Machines side-by-side -->
    <sidebyside widths="50% 50%">
        <!-- LEFT: Function Machine f -->
        <p>
            <image width="100%">
                <latex-image>
                    <![CDATA[
                    \begin{adjustbox}{max width=\linewidth}
                    \begin{tikzpicture}[x=1cm,y=1cm,>=Stealth]
                        \draw[fill=lightblue,draw=black!60] (-1.3,-0.65) rectangle (1.15,0.65);
                        \draw[fill=lightblue,draw=black!60] (-1.0,0.65)--(-1.15,1.02)--(-0.42,1.02)--(-0.22,0.65);
                        \draw[fill=lightblue,draw=black!60] (1.15,0.35)..controls(1.65,0.35)and(1.6,-0.15)..(1.15,-0.35);
                        \draw[->,gray] (-0.9,1.35) arc(155:25:0.9);
                        \draw[->,gray](1.25,-0.4)arc(-30:-55:0.65);
                        \node at (-0.05,0.1){\Large\bfseries$f$};
                        \node[font=\small] at (-0.05,-0.22){function machine};
                        \node[left,font=\small] at (-1.55,0.8){$x$};
                        \node[right,font=\small] at (1.7,-0.7){$f(x)$\quad Output};
                        \node[left,font=\small] at (-1.55,0.35){Input};
                    \end{tikzpicture}
                    \end{adjustbox}
                    ]]>
                </latex-image>
            </image>
        </p>

        <!-- RIGHT: AGE Function Machine -->
        <p>
            <image width="100%">
                <latex-image>
                    <![CDATA[
                    \begin{adjustbox}{max width=\linewidth}
                    \begin{tikzpicture}[x=1cm,y=1cm,>=Stealth]
                        \draw[fill=lightblue,draw=black!60] (-1.4,-0.7) rectangle (1.25,0.65);
                        \draw[fill=lightblue,draw=black!60] (-1.05,0.65)--(-1.2,1.05)--(-0.45,1.05)--(-0.25,0.65);
                        \draw[fill=lightblue,draw=black!60] (1.25,0.35)..controls(1.8,0.35)and(1.75,-0.15)..(1.25,-0.35);
                        \draw[->,gray] (-0.9,1.45) arc(155:25:0.95);
                        \node at (-0.05,0.05){\bfseries AGE};
                        \node[font=\small] at (-0.05,-0.25){function machine};
                        \node[left] at (-2.0,0.3){Input};
                        \node[right] at (1.65,-0.9){Output};
                        \draw[->,gray] (1.35,-0.4) arc(-30:-55:0.65);
                    \end{tikzpicture}
                    \end{adjustbox}
                    ]]>
                </latex-image>
            </image>
        </p>
    </sidebyside>

    <p>
        In this course, our functions will usually have numerical inputs and outputs. Generally, we use the variable <m>x</m> to denote input values (though we can use any other letter or symbol), and <m>y</m> or <m>f(x)</m> to denote the output values.
    </p>

    <p>
        So, most of the time we will see expressions like <m>f(x)=2x^3-2x</m>.
    </p>

    <p>
        For our purposes, an alternative definition of a function is the following:
    </p>

    <definition>
        <title>Function</title>
        <p>
            A function is an equation for which any input <m>x</m> yields exactly one output <m>y</m>.
        </p>
    </definition>

</subsection>


<!-- ========================================================
     FUNCTION NOTATION
     ======================================================== -->

<subsection xml:id="function-notation">
    <title>Function Notation</title>

    <ul>
        <li><m>f</m> is the name of the function (it could be <m>f</m>, <m>g</m>, <m>h</m>, <m>F</m>, <m>G</m>, or another letter)</li>
        <li><m>x</m> is the input (independent variable) from the domain</li>
        <li><m>f(x)</m> is the output (or <m>y</m>-value) for the corresponding <m>x</m></li>
    </ul>

    <p>
        We read <m>f(x) = 3x^2 - 4</m> as <q>f of x equals 3 x squared minus 4</q>.
    </p>

    <p>
        With function notation from <xref ref="function-age"/>, we can write <m>f(\text{Bob}) = 21</m>, meaning that the function <m>f = \text{age}</m> takes Bob and assigns him the age 21.
    </p>

    <p>
        The function that takes any number and assigns its square is represented by the equation:
    </p>
    <me>f(x) = x^2</me>
    <p>
        For instance, <m>f(2) = 2^2 = 4</m> and <m>f(-1) = (-1)^2 = 1</m>.
    </p>
</subsection>


<!-- ========================================================
     EVALUATING FUNCTIONS (Video 4)
     ======================================================== -->

<subsection xml:id="evaluating-functions">
    <title>Evaluating Functions</title>

    <!-- Video 4: Evaluating Functions -->
    <p><url href="https://youtu.be/-08_QjVDu98">Evaluating Functions Video</url></p>

    <p>
        When evaluating functions for specific inputs, replace <m>x</m> with parentheses. Then substitute the number and simplify. Don't forget the order of operations.
    </p>

    <activity>
        <statement>
            <p>
                Let <m>f(x) = 2x - 3x^2</m> and <m>g(x) = \dfrac{2x^2 + 1}{4x}</m>
            </p>
            <p>Find:</p>
            <sidebyside>
                <p><strong>a.</strong> <m>f(2)</m></p>
                <p><strong>b.</strong> <m>g(3)</m></p>
                <p><strong>c.</strong> <m>f(-4)</m></p>
                <p><strong>d.</strong> <m>g(-2)</m></p>
            </sidebyside>
        </statement>
        <solution>
            <p><em>a.</em> <m>f(2) = 2(2) - 3(2)^2 = 4 - 12 = -8</m></p>
            <p><em>b.</em> <m>g(3) = \dfrac{2(3)^2 + 1}{4(3)} = \dfrac{18 + 1}{12} = \dfrac{19}{12}</m></p>
            <p><em>c.</em> <m>f(-4) = 2(-4) - 3(-4)^2 = -8 - 48 = -56</m></p>
            <p><em>d.</em> <m>g(-2) = \dfrac{2(-2)^2 + 1}{4(-2)} = \dfrac{8 + 1}{-8} = -\dfrac{9}{8}</m></p>
        </solution>
    </activity>
</subsection>

   <p>
    Recall that given a function we can draw its graph by plotting points (ordered pairs) <m>(x,f(x))</m>.
    For instance we saw the graph of the function <m>f(x)=𝑥^2 +3</m> in <xref ref="plotting-ex"/>.
   </p>
   
   <p>
    Conversely, giving a graph we can determine whether it corresponds to a function or not, and if it does, we can find its domain and range from it.
</p>

<!-- ========================================================
         VERTICAL LINE TEST (Video 3)
         ======================================================== -->

    <subsection xml:id="vertical-line-test">
        <title>Vertical Line Test</title>

        <!-- Video 3: Vertical Line Test -->
        <p><url href="https://youtu.be/1uh-7m-SzYk">Vertical Line Test Video</url></p>

        <p>
            By the definition of a function, at most one <m>y</m>-value corresponds to a given <m>x</m>-value.
        </p>

        <p>
            This means that the graph of a function cannot have two or more different points with the same <m>x</m>-coordinate, and no two points on the graph of a function can be vertically above or below each other.
        </p>

        <p>
            It follows, then, that a vertical line can intersect the graph of a function at most once.
        </p>

        <algorithm number="no">
            <title>Vertical Line Test for Functions</title>
            <p>
                If any vertical line intersects the graph in more than one point, the graph does not represent a function. If every vertical line intersects the graph in at most one point, the graph represents a function.
            </p>
        </algorithm>

        <!-- ACTIVITY: Which graphs are functions? -->
<activity>
    <statement>
        <p>Which graphs are functions? Use the vertical line test.</p>
        <figure>
            <caption>Vertical Line Test Practice</caption>
            <image xml:id="fig-vlt-practice" width="100%">
                <shortdescription>Four graphs for vertical line test</shortdescription>
                <latex-image>
                    <![CDATA[
                    \begin{adjustbox}{max width=\linewidth}
                    \begin{tikzpicture}[x=0.6cm,y=0.6cm,>=Stealth]

                    % ---- Graph a: y = 0.5 x^2 (Parabola) ----
                    \begin{scope}[shift={(-2,7)}]
                        \draw[->,gray] (-5,0) -- (5,0) node[right]{$x$};
                        \draw[->,gray] (0,-2) -- (0,8) node[above]{$y$};
                        \foreach \x in {-4,-2,2,4}
                            \draw[gray] (\x,-0.1) -- (\x,0.1) node[below=2pt,font=\tiny]{\x};
                        \foreach \y in {2,4,6}
                            \draw[gray] (-0.1,\y) -- (0.1,\y) node[left=2pt,font=\tiny]{\y};
                        \draw[very thick,blue,domain=-3.5:3.5,samples=100] plot (\x,{0.5*\x*\x});
                        \node[anchor=west,font=\Large] at (-5,7.5) {a.\quad $y=\tfrac12x^2$};
                    \end{scope}

                    % ---- Graph b: x - y^2 = 1 (Sideways parabola) ----
                    \begin{scope}[shift={(7,7)}]
                        \draw[->,gray] (-2,0) -- (8,0) node[right]{$x$};
                        \draw[->,gray] (0,-4) -- (0,4) node[above]{$y$};
                        \foreach \x in {2,4,6}
                            \draw[gray] (\x,-0.1) -- (\x,0.1) node[below=2pt,font=\tiny]{\x};
                        \foreach \y in {-3,-2,-1,1,2,3}
                            \draw[gray] (-0.1,\y) -- (0.1,\y) node[left=2pt,font=\tiny]{\y};
                        \draw[very thick,blue,domain=-3.2:3.2,samples=100,variable=\y] plot ({1+\y*\y},\y);
                        \node[anchor=west,font=\Large] at (-2,7.5) {b.\quad $x-y^2=1$};
                    \end{scope}

                    % ---- Graph c: y = 0.25 x^3 (Cubic) ----
                    \begin{scope}[shift={(-2,-5)}]
                        \draw[->,gray] (-5,0) -- (5,0) node[right]{$x$};
                        \draw[->,gray] (0,-4) -- (0,4) node[above]{$y$};
                        \foreach \x in {-4,-2,2,4}
                            \draw[gray] (\x,-0.1) -- (\x,0.1) node[below=2pt,font=\tiny]{\x};
                        \foreach \y in {-3,-2,-1,1,2,3}
                            \draw[gray] (-0.1,\y) -- (0.1,\y) node[left=2pt,font=\tiny]{\y};
                        \draw[very thick,blue,domain=-3:3,samples=100] plot (\x,{0.25*\x*\x*\x});
                        \node[anchor=west,font=\Large] at (-5,-5.5) {c.\quad $y=\tfrac14x^3$};
                    \end{scope}

                    % ---- Graph d: x^2 = 2xy - 1  =>  y = (x^2+1)/(2x) (Hyperbola) ----
                    \begin{scope}[shift={(7,-5)}]
                        \draw[->,gray] (-6,0) -- (6,0) node[right]{$x$};
                        \draw[->,gray] (0,-5) -- (0,5) node[above]{$y$};
                        \foreach \x in {-4,-2,2,4}
                            \draw[gray] (\x,-0.1) -- (\x,0.1) node[below=2pt,font=\tiny]{\x};
                        \foreach \y in {-4,-2,2,4}
                            \draw[gray] (-0.1,\y) -- (0.1,\y) node[left=2pt,font=\tiny]{\y};
                        \draw[very thick,blue,domain=-5:-0.2,samples=100] plot (\x,{(\x*\x+1)/(2*\x)});
                        \draw[very thick,blue,domain=0.2:5,samples=100] plot (\x,{(\x*\x+1)/(2*\x)});
                        \node[anchor=west,font=\Large] at (-6,-5.5) {d.\quad $x^2=2xy-1$};
                    \end{scope}

                    \end{tikzpicture}
                    \end{adjustbox}
                    ]]>
                </latex-image>
            </image>
        </figure>
    </statement>

    <!-- SOLUTION with visual vertical lines -->
    <solution>
        <p>Use the vertical line test: if a vertical line intersects the graph more than once, it is <em>not</em> a function.</p>

        <figure>
            <caption>Vertical Line Test Applied</caption>
            <image xml:id="fig-vlt-solution" width="100%">
                <shortdescription>Vertical line test applied to four graphs</shortdescription>
                <latex-image>
                    <![CDATA[
                    \begin{adjustbox}{max width=\linewidth}
                    \begin{tikzpicture}[x=0.6cm,y=0.6cm,>=Stealth]

                    % ---- Graph a: y = 0.5 x^2 (Function) ----
                    \begin{scope}[shift={(-2,7)}]
                        \draw[->,gray] (-5,0) -- (5,0) node[right]{$x$};
                        \draw[->,gray] (0,-2) -- (0,8) node[above]{$y$};
                        \foreach \x in {-4,-2,2,4}
                            \draw[gray] (\x,-0.1) -- (\x,0.1) node[below=2pt,font=\tiny]{\x};
                        \foreach \y in {2,4,6}
                            \draw[gray] (-0.1,\y) -- (0.1,\y) node[left=2pt,font=\tiny]{\y};
                        \draw[very thick,blue,domain=-3.5:3.5,samples=100] plot (\x,{0.5*\x*\x});
                        \draw[dashed,red,thick] (1,-2) -- (1,8);  % vertical line
                        \node[green!50!black,font=\bfseries] at (-3.5,6) {Function};
                        \node[anchor=west,font=\Large] at (-5,7.5) {a.};
                    \end{scope}

                    % ---- Graph b: x - y^2 = 1 (Not a Function) ----
                    \begin{scope}[shift={(7,7)}]
                        \draw[->,gray] (-2,0) -- (8,0) node[right]{$x$};
                        \draw[->,gray] (0,-4) -- (0,4) node[above]{$y$};
                        \foreach \x in {2,4,6}
                            \draw[gray] (\x,-0.1) -- (\x,0.1) node[below=2pt,font=\tiny]{\x};
                        \foreach \y in {-3,-2,-1,1,2,3}
                            \draw[gray] (-0.1,\y) -- (0.1,\y) node[left=2pt,font=\tiny]{\y};
                        \draw[very thick,blue,domain=-3.2:3.2,samples=100,variable=\y] plot ({1+\y*\y},\y);
                        \draw[dashed,red,thick] (4,-4) -- (4,4);
                        \draw[red,fill=red] (4,1.732) circle (4pt);
                        \draw[red,fill=red] (4,-1.732) circle (4pt);
                        \node[red,font=\bfseries] at (1,3) {Not a Function};
                        \node[anchor=west,font=\Large] at (-2,7.5) {b.};
                    \end{scope}

                    % ---- Graph c: y = 0.25 x^3 (Function) ----
                    \begin{scope}[shift={(-2,-5)}]
                        \draw[->,gray] (-5,0) -- (5,0) node[right]{$x$};
                        \draw[->,gray] (0,-4) -- (0,4) node[above]{$y$};
                        \foreach \x in {-4,-2,2,4}
                            \draw[gray] (\x,-0.1) -- (\x,0.1) node[below=2pt,font=\tiny]{\x};
                        \foreach \y in {-3,-2,-1,1,2,3}
                            \draw[gray] (-0.1,\y) -- (0.1,\y) node[left=2pt,font=\tiny]{\y};
                        \draw[very thick,blue,domain=-3:3,samples=100] plot (\x,{0.25*\x*\x*\x});
                        \draw[dashed,red,thick] (2,-4) -- (2,4);
                        \node[green!50!black,font=\bfseries] at (-3.5,-3) {Function};
                        \node[anchor=west,font=\Large] at (-5,-5.5) {c.};
                    \end{scope}

                    % ---- Graph d: x^2 = 2xy - 1 (Function) ----
                    \begin{scope}[shift={(7,-5)}]
                        \draw[->,gray] (-6,0) -- (6,0) node[right]{$x$};
                        \draw[->,gray] (0,-5) -- (0,5) node[above]{$y$};
                        \foreach \x in {-4,-2,2,4}
                            \draw[gray] (\x,-0.1) -- (\x,0.1) node[below=2pt,font=\tiny]{\x};
                        \foreach \y in {-4,-2,2,4}
                            \draw[gray] (-0.1,\y) -- (0.1,\y) node[left=2pt,font=\tiny]{\y};
                        \draw[very thick,blue,domain=-5:-0.2,samples=100] plot (\x,{(\x*\x+1)/(2*\x)});
                        \draw[very thick,blue,domain=0.2:5,samples=100] plot (\x,{(\x*\x+1)/(2*\x)});
                        \draw[dashed,red,thick] (1,-5) -- (1,5);  % vertical line
                        \node[green!50!black,font=\bfseries] at (2.5,4) {Function};
                        \node[anchor=west,font=\Large] at (-6,-5.5) {d.};
                    \end{scope}

                    % Legend
                    \draw[red,dashed,thick] (0,-7.5) -- (0.5,-7.5);
                    \node[font=\small] at (2,-7.5) {Vertical line};

                    \end{tikzpicture}
                    \end{adjustbox}
                    ]]>
                </latex-image>
            </image>
        </figure>

        <p>The results are:</p>
        <ul>
            <li><strong>a.</strong> <m>y = \frac12 x^2</m> is a <em>function</em> – every vertical line intersects the parabola exactly once.</li>
            <li><strong>b.</strong> <m>x - y^2 = 1</m> is <em>not</em> a function – vertical lines intersect the graph twice (shown by the red dots).</li>
            <li><strong>c.</strong> <m>y = \frac14 x^3</m> is a <em>function</em> – every vertical line intersects the cubic exactly once.</li>
            <li><strong>d.</strong> <m>x^2 = 2xy - 1</m> is a <em>function</em> – solving for <m>y</m> gives <m>y = \frac{x^2+1}{2x}</m>, which yields exactly one <m>y</m> for each <m>x \neq 0</m>.</li>
        </ul>
    </solution>
</activity>
    </subsection>



    <!-- ========================================================
         DOMAIN AND RANGE FROM GRAPHS (Video 2)
         ======================================================== -->

    <subsection xml:id="domain-range-graphs">
        <title>Domain and Range from Graphs</title>

        <!-- Video 2: Domain and Range -->
        <p><url href="https://youtu.be/pzDfd8NXRXk">Domain and Range Video</url></p>

        <p>
            Functions can be defined by graphs (without an equation). The function is still the collection of ordered pairs <m>(x, f(x))</m>. That means we can use the graph to find the domain and range.
        </p>

        <figure>
            <caption>Domain and Range from a Graph</caption>
            <image xml:id="fig-domain-range" width="60%">
                <shortdescription>Graph showing domain and range</shortdescription>
                <latex-image>
                    <![CDATA[
                    \begin{tikzpicture}[x=0.62cm,y=0.62cm,>=Stealth]
                        \fill[cream] (-3.4,-4.5) rectangle (6.5,5.5);
                        \draw[->,gray](-3.5,0)--(6.7,0) node[right]{$x$};
                        \draw[->,gray](0,-4.6)--(0,5.7) node[above]{$y$};
                        \foreach \x in {-3,-2,-1,1,2,3,4,5,6}
                            \draw[gray] (\x,-.15)--(\x,.15) node[below=3pt,font=\small]{\x};
                        \foreach \y in {-4,-3,-2,-1,1,2,3,4,5}
                            \draw[gray] (-.15,\y)--(.15,\y) node[left=3pt,font=\small]{\y};
                        \draw[very thick] (-1,1) .. controls (-0.5,1.8) and (-0.2,2.7) .. (0,3)
                            .. controls (0.8,2.5) and (1.0,-2.4) .. (2,-3)
                            .. controls (3,-2.4) and (4.2,0.8) .. (5,2);
                        \fill ( -1,1) circle (3pt) node[above left] {$(-1,1)$};
                        \fill (0,3) circle (3pt) node[above right] {$(0,3)$};
                        \fill (2,-3) circle (3pt) node[below] {$(2,-3)$};
                        \draw[fill=white] (5,2) circle (4pt) node[above right] {$(5,2)$};
                        \node[draw=none,fill=white] at (3.15,3.35) {$y=f(x)$};
                        \draw[->] (3.05,3.05)--(4.45,2.2);
                        \draw[magenta,dashed] (-1,0)--(-1,-3.65);
                        \draw[magenta,dashed] (5,0)--(5,-3.65);
                        \draw[magenta,dashed] (0,3)--(-1.7,3);
                        \draw[magenta,dashed] (2,-3)--(-1.7,-3);
                        \draw[magenta,decorate,decoration={brace,amplitude=5pt,mirror}] (-1.7,-3.55)--(5,-3.55) node[midway,below=8pt,font=\large]{Domain};
                        \draw[magenta,decorate,decoration={brace,amplitude=5pt,mirror}] (-1.55,-3)--(-1.55,3) node[midway,left=8pt,font=\large]{Range};
                    \end{tikzpicture}
                    ]]>
                </latex-image>
            </image>
        </figure>
