            <p>Complete the table:</p>
            <tabular cols="|l|l|l|" top="minor" bottom="minor" header="1">
                <row>
                    <cell><m>x</m></cell>
                    <cell><m>y</m></cell>
                    <cell>Ordered Pair</cell>
                </row>
                <row>
                    <cell><fillin /></cell>
                    <cell><fillin /></cell>
                    <cell><fillin /></cell>
                </row>
                <row>
                    <cell><fillin /></cell>
                    <cell><fillin /></cell>
                    <cell><fillin /></cell>
                </row>
                <row>
                    <cell><fillin /></cell>
                    <cell><fillin /></cell>
                    <cell><fillin /></cell>
                </row>
                <row>
                    <cell><fillin /></cell>
                    <cell><fillin /></cell>
                    <cell><fillin /></cell>
                </row>
                <row>
                    <cell><fillin /></cell>
                    <cell><fillin /></cell>
                    <cell><fillin /></cell>
                </row>
            </tabular>
            <figure>
                <caption>Empty coordinate plane for <m>y=x^2+3</m></caption>
                <image xml:id="fig-plot1-empty" width="60%">
                    <shortdescription>Empty grid for parabola</shortdescription>
                    <latex-image>
                        <![CDATA[
                        \begin{tikzpicture}[scale=0.48]
                            \draw[step=1,black!15,thin] (-5,-2) grid (5,12);
                            \draw[thick] (-5,0) -- (5,0);
                            \draw[thick] (0,-2) -- (0,12);
                            \draw[-latex,thick] (-5.35,0) -- (5.45,0) node[right] {$x$};
                            \draw[-latex,thick] (0,-2.35) -- (0,12.45) node[above] {$y$};
                            \foreach \x in {-4,-3,-2,-1,1,2,3,4}
                                \draw (\x,0.1) -- (\x,-0.1) node[below] {$\x$};
