                    <cell><m>3</m></cell>
                    <cell><m>(0, 3)</m></cell>
                </row>
                <row>
                    <cell><m>1</m></cell>
                    <cell><m>4</m></cell>
                    <cell><m>(1, 4)</m></cell>
                </row>
                <row>
