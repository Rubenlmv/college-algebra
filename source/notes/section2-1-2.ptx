        <solution>
            <p>Choose <m>x</m> values: <m>-2, -1, 0, 1, 2</m>.</p>
            <tabular cols="|l|l|l|" top="minor" bottom="minor" header="1">
                <row>
                    <cell><m>x</m></cell>
                    <cell><m>y = x^2 + 3</m></cell>
