<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="section-2-1">
    <title>Section 2.1 Rectangular Coordinate System</title>

    <!-- ========================================================
         INTRODUCTION (NO VIDEO HERE)
         ======================================================== -->

    <subsection xml:id="intro-coordinate-system">
        <title>Rectangular Coordinate System</title>

        <p>
            Also called the <em>Cartesian Coordinate System</em>, named after René Descartes, who first proposed identifying points in a plane by using two perpendicular number lines, intersecting at <m>0</m>.
        </p>

        <!-- Figure: Coordinate System with Quadrants -->
        <figure>
            <caption>Rectangular Coordinate System with Quadrants</caption>
            <image xml:id="fig-coordinate-system" width="70%">
                <shortdescription>Coordinate system with four quadrants labeled</shortdescription>
                <latex-image>
                    <![CDATA[
                    \begin{tikzpicture}[scale=.55]
                        \draw[step=1,black!15,thin] (-6,-6) grid (6,6);
                        \draw[thick] (-6,0) -- (6,0);
                        \draw[thick] (0,-6) -- (0,6);
                        \draw[-latex,thick] (-6.35,0) -- (6.45,0) node[right] {$x$};
                        \draw[-latex,thick] (0,-6.35) -- (0,6.45) node[above] {$y$};
                        \foreach \x in {-5,-4,-3,-2,-1,1,2,3,4,5}
                            \draw (\x,0.1) -- (\x,-0.1) node[below] {$\x$};
                        \foreach \y in {-5,-4,-3,-2,-1,1,2,3,4,5}
                            \draw (0.1,\y) -- (-0.1,\y) node[left] {$\y$};
                        \node[red,font=\bfseries] at (-3.2,3.35) {Quadrant II};
                        \node[red,font=\bfseries] at (2.8,3.35) {Quadrant I};
                        \node[red,font=\bfseries] at (-3.1,-3.45) {Quadrant III};
                        \node[red,font=\bfseries] at (2.8,-3.45) {Quadrant IV};
                        \draw[red,thick,-{Stealth[length=2.5mm]}] (9.2,3.4) -- (0.1,0.1);
                        \draw[red] (9.2,3.0) rectangle (11.2,3.9);
                        \node at (10.2,3.45) {Origin};
                    \end{tikzpicture}
                    ]]>
                </latex-image>
            </image>
        </figure>
    </subsection>

    <!-- ========================================================
         PLOTTING POINTS
         ======================================================== -->

    <subsection xml:id="plotting-points">
        <title>Plotting Points</title>

        <p>
            Every point can be identified by an <em>ordered pair</em>, given as <m>(x, y)</m>.
        </p>

        <activity>
            <statement>
                <p>Plot the following points on the coordinate plane below:</p>
                <ol marker="1." columns="2">
                    <li><m>(1, 1)</m></li>
                    <li><m>(-3, -4)</m></li>
                    <li><m>(5.5, -2.5)</m></li>
                    <li><m>(0, -2)</m></li>
                    <li><m>(-3, 0)</m></li>
                </ol>

                <!-- Empty grid for the exercise -->
                <figure>
                    <caption>Empty coordinate plane</caption>
                    <image xml:id="fig-plotting-empty" width="70%">
                        <shortdescription>Empty grid for plotting</shortdescription>
                        <latex-image>
                            <![CDATA[
                            \begin{tikzpicture}[scale=0.55]
                                \draw[step=1,black!15,thin] (-6,-6) grid (6,6);
                                \draw[thick] (-6,0) -- (6,0);
                                \draw[thick] (0,-6) -- (0,6);
                                \draw[-latex,thick] (-6.35,0) -- (6.45,0) node[right] {$x$};
                                \draw[-latex,thick] (0,-6.35) -- (0,6.45) node[above] {$y$};
                                \foreach \x in {-5,-4,-3,-2,-1,1,2,3,4,5}
                                    \draw (\x,0.1) -- (\x,-0.1) node[below] {$\x$};
                                \foreach \y in {-5,-4,-3,-2,-1,1,2,3,4,5}
                                    \draw (0.1,\y) -- (-0.1,\y) node[left] {$\y$};
                            \end{tikzpicture}
                            ]]>
                        </latex-image>
                    </image>
                </figure>
            </statement>
            <solution>
                <p>The points are plotted as shown below:</p>
                <figure>
                    <caption>Plotted points</caption>
                    <image xml:id="fig-plotting-solution" width="70%">
                        <shortdescription>Coordinate plane with five points plotted</shortdescription>
                        <latex-image>
                            <![CDATA[
                            \begin{tikzpicture}[scale=0.55]
                                \draw[step=1,black!15,thin] (-6,-6) grid (6,6);
                                \draw[thick] (-6,0) -- (6,0);
                                \draw[thick] (0,-6) -- (0,6);
                                \draw[-latex,thick] (-6.35,0) -- (6.45,0) node[right] {$x$};
                                \draw[-latex,thick] (0,-6.35) -- (0,6.45) node[above] {$y$};
                                \foreach \x in {-5,-4,-3,-2,-1,1,2,3,4,5}
                                    \draw (\x,0.1) -- (\x,-0.1) node[below] {$\x$};
                                \foreach \y in {-5,-4,-3,-2,-1,1,2,3,4,5}
                                    \draw (0.1,\y) -- (-0.1,\y) node[left] {$\y$};
                                \fill[red] (1,1) circle (0.24);
                                \node[red,font=\bfseries] at (1.45,1.55) {$(1,1)$};
                                \fill[red] (-3,-4) circle (0.24);
                                \node[red,font=\bfseries] at (-3.45,-4.55) {$(-3,-4)$};
                                \fill[red] (5.5,-2.5) circle (0.24);
                                \node[red,font=\bfseries] at (5.95,-2.95) {$(5.5,-2.5)$};
                                \fill[red] (0,-2) circle (0.24);
                                \node[red,font=\bfseries] at (0.45,-2.55) {$(0,-2)$};
                                \fill[red] (-3,0) circle (0.24);
                                \node[red,font=\bfseries] at (-3.45,0.55) {$(-3,0)$};
                            \end{tikzpicture}
                            ]]>
                        </latex-image>
                    </image>
                </figure>
            </solution>
        </activity>
    </subsection>

    <!-- ========================================================
         DISTANCE FORMULA (VIDEO 1)
         ======================================================== -->

    <subsection xml:id="distance-formula">
        <title>Distance Formula</title>

        <!-- Video 1: Distance Formula -->
        <p><url href="https://echo360.org/media/757cd5c4-957c-4cfb-8575-54d160440dab/public">Distance Formula Video</url></p>

        <p>
            The distance formula between two points can be found using the Pythagorean Theorem.
        </p>

        <figure>
            <caption>Distance Formula Diagram</caption>
            <image xml:id="fig-distance-formula" width="60%">
                <shortdescription>Diagram showing distance between two points</shortdescription>
                <latex-image>
                    <![CDATA[
                    \begin{tikzpicture}[scale=0.55]
                        \draw[step=1,black!15,thin] (-6,-6) grid (6,6);
                        \draw[thick] (-6,0) -- (6,0);
                        \draw[thick] (0,-6) -- (0,6);
                        \draw[-latex,thick] (-6.35,0) -- (6.45,0) node[right] {$x$};
                        \draw[-latex,thick] (0,-6.35) -- (0,6.45) node[above] {$y$};
                        \foreach \x in {-5,-4,-3,-2,-1,1,2,3,4,5}
                            \draw (\x,0.1) -- (\x,-0.1) node[below] {$\x$};
                        \foreach \y in {-5,-4,-3,-2,-1,1,2,3,4,5}
                            \draw (0.1,\y) -- (-0.1,\y) node[left] {$\y$};
                        \coordinate (A) at (4,4);
                        \coordinate (B) at (-4,-2);
                        \draw[red,very thick] (A)--(B);
                        \fill[red] (A) circle (0.24);
                        \fill[red] (B) circle (0.24);
                        \draw[red,dashed,very thick] (4,4)--(4,-2)--(-4,-2);
                        \draw[red,very thick] (-4,-2) -- (4,-2);
                        \draw[red,very thick] (4,-2) -- (4,4);
                        \node[red,below] at (0,-2.3) {$(x_2-x_1)$};
                        \node[red,right] at (4.3,-1) {$(y_2-y_1)$};
                        \node[left] at (-4,-2) {$(x_2,y_2)$};
                        \node[right] at (4,4) {$(x_1,y_1)$};
                    \end{tikzpicture}
                    ]]>
                </latex-image>
            </image>
        </figure>

        <me>d = \sqrt{(x_2 - x_1)^2 + (y_2 - y_1)^2}</me>

        <activity>
            <statement>
                <p><em>Example.</em> Find the distance between the points <m>(-3, -4)</m> and <m>(3, 0)</m>. Give the exact distance and an approximation to 2 decimal places.</p>
            </statement>
            <solution>
                <p><em>Step 1: Identify the coordinates.</em></p>
                <p>Let <m>(x_1, y_1) = (-3, -4)</m> and <m>(x_2, y_2) = (3, 0)</m>.</p>
                <p><em>Step 2: Apply the distance formula.</em></p>
                <me>d = \sqrt{(3 - (-3))^2 + (0 - (-4))^2}</me>
                <me>d = \sqrt{6^2 + 4^2}</me>
                <me>d = \sqrt{36 + 16}</me>
                <me>d = \sqrt{52} = 2\sqrt{13}</me>
                <p><em>Step 3: Approximate to 2 decimal places.</em></p>
                <me>d \approx 7.21</me>
                <p>Therefore, the exact distance is <m>2\sqrt{13}</m> and the approximate distance is <m>7.21</m>.</p>
            </solution>
        </activity>
    </subsection>

    <!-- ========================================================
         MIDPOINT FORMULA (VIDEO 2)
         ======================================================== -->

    <subsection xml:id="midpoint-formula">
        <title>Midpoint Formula</title>

        <!-- Video 2: Midpoint Formula -->
        <p><url href="https://youtu.be/pzDfd8NXRXk">Midpoint Formula Video</url></p>

        <p>
            The midpoint of the line segment with endpoints <m>(x_1, y_1)</m> and <m>(x_2, y_2)</m> is:
        </p>
        <me>\left(\frac{x_1 + x_2}{2}, \frac{y_1 + y_2}{2}\right)</me>

        <activity>
            <statement>
                <p><em>Example.</em> Find the midpoint of the line segment with endpoints <m>(-1.5, -3)</m> and <m>(4.5, 5)</m>.</p>
            </statement>
            <solution>
                <p><em>Step 1: Identify the coordinates.</em></p>
                <p>Let <m>(x_1, y_1) = (-1.5, -3)</m> and <m>(x_2, y_2) = (4.5, 5)</m>.</p>
                <p><em>Step 2: Apply the midpoint formula.</em></p>
                <me>\left(\frac{-1.5 + 4.5}{2}, \frac{-3 + 5}{2}\right)</me>
                <me>\left(\frac{3}{2}, \frac{2}{2}\right)</me>
                <me>(1.5, 1)</me>
                <p>Therefore, the midpoint is <m>(1.5, 1)</m>.</p>
            </solution>
        </activity>

        <figure>
            <caption>Midpoint of a line segment</caption>
            <image xml:id="fig-midpoint" width="60%">
                <shortdescription>Line segment with midpoint marked</shortdescription>
                <latex-image>
                    <![CDATA[
                    \begin{tikzpicture}[scale=0.55]
                        \draw[step=1,black!15,thin] (-3,-7) grid (7,6);
                        \draw[thick] (-3,0) -- (7,0);
                        \draw[thick] (0,-7) -- (0,6);
                        \draw[-latex,thick] (-3.35,0) -- (7.45,0) node[right] {$x$};
                        \draw[-latex,thick] (0,-7.35) -- (0,6.45) node[above] {$y$};
                        \foreach \x in {-2,-1,1,2,3,4,5,6}
                            \draw (\x,0.1) -- (\x,-0.1) node[below] {$\x$};
                        \foreach \y in {-6,-5,-4,-3,-2,-1,1,2,3,4,5}
                            \draw (0.1,\y) -- (-0.1,\y) node[left] {$\y$};
                        \draw[red,very thick] (-1.5,-3)--(4.5,5);
                        \fill[red] (-1.5,-3) circle (0.24);
                        \fill[red] (4.5,5) circle (0.24);
                        \fill[blue] (1.5,1) circle (0.3);
                    \end{tikzpicture}
                    ]]>
                </latex-image>
            </image>
        </figure>
    </subsection>
