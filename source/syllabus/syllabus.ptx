                </row>
                <row>
                    <cell>Quizzes</cell>
                    <cell>15%</cell>
                </row>
                <row>
                    <cell>Tests (3)</cell>
                    <cell>40%</cell>
                </row>
                <row>
                    <cell>Final Examination (comprehensive)</cell>
