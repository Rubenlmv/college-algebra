<worksheet xml:id="worksheet-section-1-1">
    <title>Worksheet: Section 1.1 Linear Equations and Rational Equations</title>

    <introduction>
        <p>
            <em>Name:</em> <fillin /> <space />
            <em>Date:</em> <fillin /> <space />
            <em>Section:</em> <fillin />
        </p>
